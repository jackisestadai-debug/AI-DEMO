# Existing AI Appointment Setter demo (app/assistant, app/api/chat)
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
CLIENT_ID=

# Store — order storage (Supabase). Leave empty and orders just won't be
# persisted; checkout still works.
SUPABASE_SERVICE_ROLE_KEY=

# Store — payments (Stripe). Leave empty to run checkout in test mode: orders
# are saved but no real card is charged. Set both once you're ready to take
# real payments.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store — Stripe webhook (order confirmation -> supplier push). Get this from
# the Stripe Dashboard once a webhook endpoint pointing at
# /api/webhooks/stripe is created for the checkout.session.completed event.
STRIPE_WEBHOOK_SECRET=

# Store — supplier automation (CJdropshipping). Leave empty and paid orders
# just get flagged "paid_awaiting_manual_fulfillment" instead of auto-pushed.
# Get this from CJdropshipping dashboard -> API -> Add API Key.
CJ_API_KEY=

# Store — legal/kontakt (lib/company.ts). Required by e-handelslagen to be
# shown publicly on the site (footer, /kontakt) — this only keeps it out of
# git history, it's still rendered on the live site.
NEXT_PUBLIC_COMPANY_ORG_NUMBER=
